  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/eslint": "^8.56.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "jest": "^30.5.2",
    "prisma": "^6.19.3",
    "ts-jest": "^29.4.14",
